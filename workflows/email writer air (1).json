        "jsCode": "// The AI response is inside $json.output and usually looks like:\n// ```json\n// { \"email1\": {...}, \"email2\": {...}, ... }\n// ```\n\nlet raw = $json.output || \"\";\n\n// Remove code fences (```json ... ```)\nraw = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// Parse into real JSON\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error(\"Failed to parse AI JSON: \" + e.message + \"\\nRaw: \" + raw);\n}\n\nreturn [\n  {\n    json: parsed\n  }\n];\n"
